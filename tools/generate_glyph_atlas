from rectpack import newPacker  # Install using pip install rectpack
from shared.paths import PROJECT_PATHS, REPO_DIR, SHARED_SRC_DIR


@dataclass
class Rect:
    x: int
    y: int
    w: int
    h: int


@dataclass
class GlyphSprite:
    index: int
    source_image_path: Path
    source_image_width: int = 0
    source_image_height: int = 0
    source_rect: Rect | None = None
    target_image_path: Path | None = None
    target_rect: Rect | None = None
    bbox: Rect | None = None


@dataclass
class Glyph:
    text: str
    sprite: GlyphSprite
    target_width: int

    def __repr__(self) -> None:
        return f"{self.text}"


type GlyphMap = dict[str, Glyph]
type GlyphSpriteMap = dict[str, GlyphSprite]


def find_gaps(lst: list[int]) -> list[tuple[int, int]]:
    """Finds gaps in a sequential, sorted list of integers."""
    return [(i, i + 1) for i in range(len(lst) - 1) if lst[i + 1] - lst[i] > 1]


def generate_def_file(glyphs: list[Glyph], output_path):
    with output_path.open("w") as handle:
        print(
            r"""// This file is autogenerated. See tools/generate_glyph_atlas for details.
GLYPH_DEFINE(-1, "\n", 0, GLYPH_NEWLINE)
GLYPH_DEFINE(-1, " ",  0, GLYPH_SPACE)
""",
            file=handle,
        )

        for glyph in glyphs:
            args = [
                str(glyph.sprite.index),
                json.dumps(glyph.text, ensure_ascii=False),
                str(
                    glyph.target_width
                    if glyph.target_width > 0
                    else glyph.sprite.source_image_width
                ),
                (
                    "GLYPH_COMBINING"
                    if glyph.target_width == 0
                    else "GLYPH_NORMAL"
                ),
            ]

            print(f"GLYPH_DEFINE({', '.join(args)})", file=handle)

    print("Saved", output_path)


def generate_injection_map_file(
    sprites: list[GlyphSprite], output_path
) -> None:
    output_path.write_text(
        json.dumps(
            [
                {
                    "mesh_num": sprite.index,
                    "filename": sprite.target_image_path.name,
                    "x": sprite.target_rect.x,
                    "y": sprite.target_rect.y,
                    "w": sprite.target_rect.w,
                    "h": sprite.target_rect.h,
                    "l": sprite.bbox.x if sprite.bbox else 0,
                    "t": (sprite.bbox.y if sprite.bbox else -16),
                    "r": (
                        sprite.bbox.x + sprite.target_rect.w
                        if sprite.bbox
                        else sprite.target_rect.w
                    ),
                    "b": (
                        sprite.bbox.y + sprite.source_image_height
                        if sprite.bbox
                        else -16 + sprite.target_rect.h
                    ),
                }
                for sprite in sprites
            ]
        )
    )
    print("Saved", output_path)


def read_glyph_mapping(game: int) -> tuple[GlyphMap, GlyphSpriteMap]:
    input_dir = PROJECT_PATHS[game].data_dir / "glyphs"
    mapping_path = input_dir / "mapping.json5"
    items = pyjson5.loads(mapping_path.read_text())

    sprite_index_map: dict[str, int] = {
        key: int(items.get("force_index", -1)) for key, item in items.items()
    }

    glyph_map: dict[str, Glyph] = {}
    for text, item in items.items():
        glyph = Glyph(
            text=text,
            sprite=None,
            target_width=int(item.get("width", -1)),
        )
        glyph_map[text] = glyph

    def make_sprite(text: str, item: dict, index: int) -> None:
        resolved_item = (
            items[link_text] if (link_text := item.get("link")) else item
        )
        sprite = GlyphSprite(
            index=sprite_index,
            source_image_path=input_dir / resolved_item["filename"],
        )
        if not sprite.source_image_path.exists():
            print(
                f"Warning: glyph {text!r} does not exist in {sprite.source_image_path}",
                file=sys.stderr,
            )
            return

        if bbox := item.get("bbox"):
            sprite.bbox = Rect(
                x=bbox["x1"],
                y=bbox["y1"],
                w=bbox["x2"] - bbox["x1"],
                h=bbox["y2"] - bbox["y1"],
            )

        sprite_map[text] = sprite
        glyph_map[text].sprite = sprite

    sprite_map: dict[str, GlyphSprite] = {}
    # First pass - create sprites with forced indices
    for text, item in items.items():
        if (sprite_index := int(item.get("force_index", -1))) != -1:
            assert "link" not in item, "Links cannot force sprite indices"
            make_sprite(text, item, sprite_index)

    # Second pass - create sprites for non-link glyphs
    for text, item in items.items():
        if not item.get("link") and not sprite_map.get(text):
            sprite_index = (
                max(sprite.index for sprite in sprite_map.values()) + 1
            )
            make_sprite(text, item, sprite_index)

    # Third pass - assign sprite indices to link glyphs
    for text, item in items.items():
        if not (link_text := item.get("link")):
            continue
        glyph_map[text].sprite = sprite_map[link_text]

    # Remove glyphs without mapped sprites
    for text, glyph in glyph_map.items():
        if not glyph.sprite:
            print(f'Removing {glyph!r} because it cannot be mapped to a sprite', file=sys.stderr)
    glyph_map = {
        text: glyph for text, glyph in glyph_map.items() if glyph.sprite
    }

    # Check for linearity of mesh indices
    sprite_indices = sorted(
        set(glyph.sprite.index for glyph in glyph_map.values())
    )
    if find_gaps(sprite_indices):
        print("Warning: sprite indices are not linear!", file=sys.stderr)

    return glyph_map, sprite_map


def pack_sprites(
    sprites: list[GlyphSprite], output_dir: Path, page_size: int, padding: int
):
    # Initialize the packer with unlimited bins
    packer = newPacker(rotation=False)

    # Add rectangles to the packer
    for ref_num, sprite in enumerate(sprites):
        packer.add_rect(
            sprite.source_image_width + padding * 2,
            sprite.source_image_height + padding * 2,
            (ref_num,),
        )

    # Add bins (target images) of specified size
    packer.add_bin(page_size, page_size, count=float("inf"))

    # Pack the glyphs
    packer.pack()

    # Iterate over all bins (new texture pages)
    for dst_page_num, bin in enumerate(packer):
        dst_pixels = np.zeros((page_size, page_size, 4))

        output_path = output_dir / f"alpha_sprites_{dst_page_num:02d}.png"

        for rect in bin:
            width, height = rect.width, rect.height
            dst_x, dst_y = rect.x, rect.y
            (ref_num,) = rect.rid

            dst_x += padding
            dst_y += padding
            width -= 2 * padding
            height -= 2 * padding
            sprite = sprites[ref_num]

            # Update the packed rectangle information
            sprite.target_image_path = output_path
            sprite.target_rect = Rect(x=dst_x, y=dst_y, w=width, h=height)

            # Blit the image
            src_image = Image.open(sprite.source_image_path).convert("RGBA")
            src_pixels = src_pixels = np.array(src_image)
            dst_pixels[
                dst_y : dst_y + src_image.height,
                dst_x : dst_x + src_image.width,
            ] = src_pixels[:, :]

        image = Image.fromarray(dst_pixels.astype("uint8"), "RGBA")
        image.save(output_path)
        print("Saved", output_path)


def get_sprite_image_size(sprite: GlyphSprite) -> GlyphSprite:
    with Image.open(sprite.source_image_path) as img:
        sprite.source_image_width, sprite.source_image_height = img.size
    return sprite


def fill_image_sizes(sprites: list[GlyphSprite]) -> None:
    with ThreadPoolExecutor() as pool:
        pool.map(get_sprite_image_size, sprites)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("game", type=int)
    parser.add_argument("--output-dir", type=Path, default=REPO_DIR)
    parser.add_argument("--page-size", type=int, default=256)
    parser.add_argument("--padding", type=int, default=1)
    return parser.parse_args()


def main() -> None:
    args = parse_args()

    def_path = SHARED_SRC_DIR / f"game/text_tr{args.game}.def"
    injection_map_path = args.output_dir / "glyph_info.json"
    atlas_dir = args.output_dir

    glyph_map, sprite_map = read_glyph_mapping(args.game)
    fill_image_sizes(list(sprite_map.values()))

    pack_sprites(
        list(sprite_map.values()),
        output_dir=atlas_dir,
        page_size=args.page_size,
        padding=args.padding,
    )
    generate_def_file(glyph_map.values(), def_path)
    generate_injection_map_file(list(sprite_map.values()), injection_map_path)


if __name__ == "__main__":
    main()
